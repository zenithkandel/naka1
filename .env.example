# Database
DATABASE_URL=sqlite+aiosqlite:///data/border_vision.db
# DATABASE_URL=mysql+aiomysql://bv_user:bv_pass@localhost:3306/border_vision

# Camera
CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://user:pass@192.168.1.100:554/stream1

# API
API_HOST=0.0.0.0
API_PORT=8000

# Detection
YOLO_MODEL=yolov8s
YOLO_CONFIDENCE=0.45
USE_OPENVINO=true

# Crossing
HYSTERESIS_FRAMES=5
